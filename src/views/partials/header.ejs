<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <%- styles.join('') %>
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/inventory">Browse Vehicles</a></li>
                <li><a href="/contact">Contact</a></li>
                <% if (isLoggedIn) { %>
                    <li><a href="/account">My Account</a></li>
                    <li><a href="/service">Service Requests</a></li>
                    <% if (userRole === 'employee' || userRole === 'owner') { %>
                        <li><a href="/admin">Admin Dashboard</a></li>
                    <% } %>
                    <li><a href="/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/login">Login</a></li>
                    <li><a href="/register">Register</a></li>
                <% } %>
            </ul>
        </nav>
    </header>
    <% 
        const messages = flash();
        const hasMessages = Object.values(messages).some(arr => arr.length > 0);
    %>
    <% if (hasMessages) { %>
        <div class="flash-messages">
            <% Object.keys(messages).forEach(type => { %>
                <% messages[type].forEach(message => { %>
                    <div class="flash <%= type %>">
                        <%= message %>
                    </div>
                <% }); %>
            <% }); %>
        </div>
    <% } %>