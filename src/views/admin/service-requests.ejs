<%- include('../partials/header') %>
<main>
    <div class="admin-page-header">
        <h1><%= title %></h1>
    </div>

    <% if (requests.length === 0) { %>
        <p class="empty-state">No service requests submitted yet.</p>
    <% } else { %>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Service Type</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% requests.forEach(request => { %>
                    <tr>
                        <td><%= request.id %></td>
                        <td>
                            <%= request.user_name %><br>
                            <small><%= request.user_email %></small>
                        </td>
                        <td><%= request.vehicle_description %></td>
                        <td><%= request.service_type %></td>
                        <td>
                            <span class="status-badge status-<%= request.status.toLowerCase().replace(' ', '-') %>">
                                <%= request.status %>
                            </span>
                        </td>
                        <td><%= new Date(request.created_at).toLocaleDateString() %></td>
                        <td>
                            <a href="/admin/service-requests/<%= request.id %>" class="btn-small btn-edit">Update</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>

    <div class="admin-back">
        <a href="/admin">← Back to Dashboard</a>
    </div>
</main>
<%- include('../partials/footer') %>
